# Dockerfile.api — builds the hotel-platform API + background workers.
#
# The workspace packages (@billing/db, domain-registry, gst-engine, shared,
# pdf) ship as raw TypeScript with no build step of their own — apps/api
# consumes them directly via tsx's on-the-fly transpilation, same as dev.
# This image runs the same way in production rather than fighting that
# (see render.yaml for the fuller explanation).
#
# Two services (API server, background workers) share this one image —
# only the final CMD differs, overridden per-service on Render via
# dockerCommand.
#
# Installs the FULL workspace (not filtered to @hotel/api) — pnpm's
# --filter with a transitive dependency (packages/db) doesn't reliably
# pull in that dependency's own devDependencies (e.g. the `prisma` CLI
# packages/db needs for `prisma generate`), and --frozen-lockfile requires
# every workspace package.json to be present anyway or it refuses to run.
#
# Debian-based (node:22-slim), not Alpine — Prisma's query engine binary
# needs libssl.so.1.1, which Alpine 3.2x's OpenSSL-3 base no longer ships.
# This is a well-known Prisma+Alpine incompatibility; slim sidesteps it.

FROM node:22-slim AS base
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN corepack enable && corepack prepare pnpm@9.5.0 --activate
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @billing/db exec prisma generate

WORKDIR /app/apps/api
ENV NODE_ENV=production

# Default: run the API server. Workers service overrides this on Render.
CMD ["npx", "tsx", "src/server.ts"]
