# ── Security ──────────────────────────────────────────────────────────────────
# This key must match CUSTOM_AI_API_KEY in apps/api/.env
SERVICE_API_KEY=choose-any-long-random-secret

# ── Model backend ─────────────────────────────────────────────────────────────
# Which backend serves your fine-tuned model?
# Options: ollama | vllm | openai_compat
MODEL_BACKEND=ollama

# ── Ollama (recommended for local / single server) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Name you gave when loading: ollama create hisabkitab -f Modelfile
OLLAMA_CHAT_MODEL=hisabkitab
# For vision tasks (bill OCR) — llava if your model doesn't support vision
OLLAMA_VISION_MODEL=llava

# ── vLLM (recommended for production / high traffic) ─────────────────────────
# VLLM_BASE_URL=http://localhost:8000
# VLLM_MODEL=./hisabkitab-model/merged

# ── OpenAI-compatible API (e.g. LM Studio, LocalAI, Together, Groq) ──────────
# OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPAT_API_KEY=lm-studio
# OPENAI_COMPAT_MODEL=hisabkitab

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
